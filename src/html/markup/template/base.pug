include ../mixins/menu
include ../mixins/more

//- Begin ===============================================================================
doctype html
html(lang='en')

	head
		meta(charset='utf-8')
		title OBLIQUE STRATEGIES

		//- Prevent scaling  and pinch zoomming on touch enabled devices
		meta(name='viewport', content='user-scalable=no, width=device-width, initial-scale=1, maximum-scale=1')
		meta(name='description', content='Oblique Strategies - Inspirational help')
		meta(name='author', content='brian eno, harold schmidt, designerzen')
		meta(name="msapplication-tap-highlight", content="no")
		script(type='module', src='./scripts/main.js')

	body.loading

		header
			h1 Oblique Strategies
			h2 Simplified Inspiration

			nav#main-menu
				block menu
					+navigation(decks, 0)

		//- Content ==================================================================================
		main#content
			article
				section
					header
						block header

					ul#deck.cards
						block cards
						//- Reload the entire Deck!
						li.reload
							p.visuallyhidden This is the last card from this pack. Select another pack or to shuffle this pack and view it again.
							button#shuffle(type='button') Shuffle Deck
							block reload
								+more(decks,0)

					footer
						block footer

		//- Main Footer ===============================================================================
		include ../partials/footer
			include ../partials/social
